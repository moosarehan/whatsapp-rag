# Required for answer generation and query expansion
GROQ_API_KEY=

# Qdrant: use local embedded storage by default, or set a server URL
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Optional model/runtime settings
GROQ_MODEL_NAME=openai/gpt-oss-120b
LLM_MAX_TOKENS=1500
MAX_CONTEXT_TOKENS=3800

# WhatsApp export parsing
WHATSAPP_DAY_FIRST=false
WHATSAPP_TIMEZONE=Asia/Karachi

# Frontend API endpoint
VITE_API_URL=http://localhost:8000
